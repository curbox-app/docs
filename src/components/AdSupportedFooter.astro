---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
---

<div class="docs-ad docs-ad--compact" aria-label="Advertisement">
  <span class="docs-ad__label">Advertisement</span>
  <div class="docs-ad__compact-slot">
    <script is:inline>
      atOptions = {
        'key' : 'e628ac9098f3174a95ddcfe2a8246bcc',
        'format' : 'iframe',
        'height' : 50,
        'width' : 320,
        'params' : {}
      };
    </script>
    <script
      is:inline
      src="https://www.highperformanceformat.com/e628ac9098f3174a95ddcfe2a8246bcc/invoke.js"
    ></script>
  </div>
</div>

<DefaultFooter />

<div class="docs-ad docs-ad--native" aria-label="Advertisement">
  <span class="docs-ad__label">Advertisement</span>
  <script
    is:inline
    async="async"
    data-cfasync="false"
    src="https://pl30925041.effectivecpmnetwork.com/d2a3f724f27587131efa763529c9a444/invoke.js"
  ></script>
  <div id="container-d2a3f724f27587131efa763529c9a444"></div>
</div>

<div
  class="ad-banner ad-placement ad-unit docs-ad-bait"
  aria-hidden="true"
  style="position: absolute; left: -10000px; top: -10000px; width: 1px; height: 1px; pointer-events: none;"
></div>

<aside
  id="funding-notice"
  class="funding-notice"
  role="dialog"
  aria-labelledby="funding-notice-title"
  aria-describedby="funding-notice-description"
  hidden
>
  <div class="funding-notice__copy">
    <strong id="funding-notice-title">Please consider allowing ads on Curbox</strong>
    <p id="funding-notice-description">
      Curbox is completely free. Donations and unobtrusive ads help fund development and hosting,
      keeping the app free and open source for everyone.
    </p>
  </div>
  <div class="funding-notice__actions">
    <button class="funding-notice__allow" type="button">I’ve disabled it — reload</button>
    <button class="funding-notice__dismiss" type="button">Not now</button>
  </div>
</aside>

<script is:inline>
  (() => {
    const dismissalKey = 'curbox-ad-block-notice-dismissed';

    try {
      if (sessionStorage.getItem(dismissalKey) === 'true') return;
    } catch {
      // Storage can be unavailable in strict privacy modes; detection can still run.
    }

    const detectAdBlocker = () => {
      window.setTimeout(() => {
        const bait = document.querySelector('.docs-ad-bait');
        const compactSlot = document.querySelector('.docs-ad__compact-slot');
        const notice = document.getElementById('funding-notice');
        if (!bait || !compactSlot || !notice) return;

        const baitStyle = window.getComputedStyle(bait);
        const baitWasBlocked =
          baitStyle.display === 'none' ||
          baitStyle.visibility === 'hidden' ||
          bait.getBoundingClientRect().height === 0;
        const adWasBlocked = !compactSlot.querySelector('iframe');

        if (baitWasBlocked || adWasBlocked) notice.hidden = false;
      }, 1500);
    };

    if (document.readyState === 'complete') {
      detectAdBlocker();
    } else {
      window.addEventListener('load', detectAdBlocker, { once: true });
    }

    document.querySelector('.funding-notice__allow')?.addEventListener('click', () => {
      window.location.reload();
    });

    document.querySelector('.funding-notice__dismiss')?.addEventListener('click', () => {
      const notice = document.getElementById('funding-notice');
      if (notice) notice.hidden = true;
      try {
        sessionStorage.setItem(dismissalKey, 'true');
      } catch {
        // Dismissing still works when storage is unavailable.
      }
    });
  })();
</script>

<style>
  .docs-ad {
    width: 100%;
    margin-inline: auto;
    text-align: center;
  }

  .docs-ad--compact {
    margin-top: 2.5rem;
  }

  .docs-ad--native {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .docs-ad__label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--sl-color-gray-3);
    font-size: 0.65rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .docs-ad__compact-slot {
    width: 320px;
    min-height: 50px;
    max-width: 100%;
    margin-inline: auto;
    overflow: hidden;
  }

  .funding-notice {
    position: fixed;
    z-index: 100;
    right: 1rem;
    bottom: 1rem;
    width: min(28rem, calc(100vw - 2rem));
    padding: 1rem;
    color: var(--sl-color-text);
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    box-shadow: 0 10px 35px rgb(0 0 0 / 18%);
  }

  .funding-notice[hidden] {
    display: none;
  }

  .funding-notice__copy strong {
    display: block;
    font-size: var(--sl-text-base);
  }

  .funding-notice__copy p {
    margin: 0.4rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  .funding-notice__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .funding-notice__actions button {
    min-height: 2.25rem;
    padding: 0.4rem 0.75rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    border-radius: 0.4rem;
    cursor: pointer;
  }

  .funding-notice__allow {
    color: var(--sl-color-text-invert);
    background: var(--sl-color-accent);
    border: 1px solid var(--sl-color-accent);
  }

  .funding-notice__allow:hover {
    background: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent-high);
  }

  .funding-notice__dismiss {
    color: var(--sl-color-text);
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
  }

  .funding-notice__dismiss:hover {
    background: var(--sl-color-bg-sidebar);
  }

  .funding-notice__actions button:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }

  @media print {
    .docs-ad,
    .funding-notice {
      display: none;
    }
  }
</style>

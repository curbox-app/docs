---
import { base } from '../utils/base-url';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const sections = [
  {
    label: 'Getting Started',
    items: [
      { label: 'What Is Curbox', slug: 'getting-started/what-is-curbox' },
      { label: 'Set Up Curbox', slug: 'getting-started/setup' },
    ],
  },
  {
    label: 'Focus',
    items: [
      { label: 'Focus Mode', slug: 'focus/focus-mode' },
    ],
  },
  {
    label: 'Reducers',
    items: [
      { label: 'Overview', slug: 'reducers/overview' },
      { label: 'App Pause', slug: 'reducers/app-pause' },
      { label: 'Short-Form Video Content', slug: 'reducers/short-form-video' },
      { label: 'Keywords and Websites', slug: 'reducers/keyword-blocker' },
      { label: 'Hide UI Elements', slug: 'reducers/hide-ui-elements' },
      { label: 'Auto DND', slug: 'reducers/auto-dnd' },
      { label: 'Mindful Messages', slug: 'reducers/mindful-messages' },
      { label: 'Short-Form Video Counter', slug: 'reducers/video-counter' },
      { label: 'Grayscale Filter', slug: 'reducers/grayscale' },
      { label: 'Settings Change Delay', slug: 'reducers/settings-change-delay' },
      { label: 'Tamper Protection', slug: 'reducers/tamper-protection' },
    ],
  },
  {
    label: 'Unlock Challenges',
    items: [
      { label: 'Overview', slug: 'unlock-challenges/overview' },
    ],
  },
  {
    label: 'Usage',
    items: [
      { label: 'Usage Stats', slug: 'usage/usage-stats' },
    ],
  },
];
---

<StarlightPage frontmatter={{ title: 'Welcome to Curbox Docs', description: 'Everything you need to get the most out of Curbox.' }}>
  <div class="home-hero">
    <p class="version-badge">Documentation for Curbox v4</p>
    <h1>Take back your time. ♥</h1>
    <p class="tagline">
      Curbox is a free, open-source Android app that helps you spend less time on your phone
      on your own terms. No cloud, no tracking, no subscriptions. Just quiet tools that stay out
      of your way until you need them.
    </p>
    <a class="cta-button" href={`${base}getting-started/what-is-curbox/`}>Get started →</a>
  </div>

  <div class="doc-grid">
    {sections.map((section) => (
      <div class="doc-section">
        <h2>{section.label}</h2>
        <ul>
          {section.items.map((item) => (
            <li>
              <a href={`${base}${item.slug}/`}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</StarlightPage>

<style>
  .home-hero {
    text-align: center;
    padding: 3rem 1rem 2.5rem;
    max-width: 680px;
    margin: 0 auto;
  }

  .version-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    padding: 0.2rem 0.85rem;
    margin-bottom: 1.25rem;
  }

  .home-hero h1 {
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1rem;
    color: var(--sl-color-text);
  }

  .tagline {
    font-size: 1.05rem;
    color: var(--sl-color-gray-2);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .cta-button,
  .cta-button:visited {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.6rem 1.5rem;
    background: var(--sl-color-accent);
    color: #fff !important;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .cta-button:hover {
    background: var(--sl-color-accent-high);
    color: #fff !important;
  }

  .doc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    max-width: 900px;
    margin: 2rem auto 0;
    padding: 0 1rem;
  }

  .doc-section {
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
  }

  .doc-section h2 {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--sl-color-accent-high);
    margin: 0 0 0.75rem;
    border: none;
    padding: 0;
  }

  .doc-section ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .doc-section a {
    font-size: 0.95rem;
    color: var(--sl-color-text);
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .doc-section a:hover {
    color: var(--sl-color-accent);
  }
</style>
